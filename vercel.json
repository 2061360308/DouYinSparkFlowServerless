{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "server/index.py", "use": "@vercel/python" },
    {
      "src": "panel/package.json",
      "use": "@vercel/static-build",
      "config": { "outputDirectory": "dist" }
    }
  ],
  "functions": {
    "server/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.py" },
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "dest": "/panel/assets/$1" },
    { "src": "/(.*\\.[a-zA-Z0-9]+)", "dest": "/panel/$1" },
    { "src": "/(.*)", "dest": "/panel/index.html" }
  ]
}
