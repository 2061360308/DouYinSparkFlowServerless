# 复制为 terraform.tfvars 并修改实际值
# 认证: 在执行目录 export ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET (region 用 ALIBABA_CLOUD_REGION 或本文件 region)

region = "cn-hangzhou"
zone_id = "cn-hangzhou-b"

name_prefix = "cloakbrowser"
role_name   = "cloakbrowser-fc3-role"

function_name = "cloakbrowser"
image_url     = "crpi-yagm0mg4gyj902wq.cn-hangzhou.personal.cr.aliyuncs.com/oilu/cloakbrowser-serverless:latest"

cpu         = 1
memory_size = 1536
disk_size   = 10240
function_timeout = 600
instance_concurrency = 1
internet_access = true

container_port = 9000
trigger_name   = "webTrigger"
trigger_auth_type = "anonymous"

# 会话亲和 (header 亲和, 键名 sessionid)
session_affinity_header_field_name = "sessionid"
session_ttl_seconds                = 600
session_idle_timeout_seconds       = 30
session_concurrency_per_instance   = 1
disable_session_id_reuse           = false

# 公网出口 (固定 IP)
eip_bandwidth          = 5
eip_internet_charge_type = "PayByTraffic"
eip_isp                = "BGP"
nat_type               = "Enhanced"
nat_payment_type       = "PayAsYouGo"
nat_internet_charge_type = "PayByLcu"

vpc_cidr_block     = "172.16.0.0/16"
vswitch_cidr_block = "172.16.0.0/24"